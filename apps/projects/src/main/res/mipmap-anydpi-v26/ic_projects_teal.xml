<?xml version="1.0" encoding="utf-8"?>
<!-- The Projects icon for the Teal theme: the same glyph and inset as
     ic_projects, tinted. LauncherTint shows it through its manifest alias. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:inset="13.0%">
            <bitmap
                android:src="@mipmap/ic_projects_foreground"
                android:tint="#29B1A4" />
        </inset>
    </foreground>
</adaptive-icon>
