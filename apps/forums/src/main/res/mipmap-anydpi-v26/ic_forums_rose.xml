<?xml version="1.0" encoding="utf-8"?>
<!-- The Forums icon for the Rose theme: the same glyph and inset as
     ic_forums, tinted. LauncherTint shows it through its manifest alias. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:inset="10.6%">
            <bitmap
                android:src="@mipmap/ic_forums_foreground"
                android:tint="#E569A9" />
        </inset>
    </foreground>
</adaptive-icon>
