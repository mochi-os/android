<?xml version="1.0" encoding="utf-8"?>
<!--
    The spelling the regional English overlays change, as the base spells it.
    Android gives an English locale with no catalogue of its own (en-GB, en-AU,
    en) its language's nearest region before the base, so without this every
    English reader would be given a regional spelling.
-->
<resources>
    <string name="calendars_colour">Colour</string>
    <string name="calendars_status_cancelled">Cancelled</string>
    <string name="calendars_event_colour_value">Colour value</string>
</resources>
