<?xml version="1.0" encoding="utf-8"?>
<!-- The Staff icon for the Teal theme: the same glyph and inset as
     ic_staff, tinted. LauncherTint shows it through its manifest alias. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <bitmap
            android:src="@mipmap/ic_staff_foreground"
            android:tint="#29B1A4" />
    </foreground>
</adaptive-icon>
