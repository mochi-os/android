<?xml version="1.0" encoding="utf-8"?>
<!-- The Wikis icon for the Terracotta theme: the same glyph and inset as
     ic_wikis, tinted. LauncherTint shows it through its manifest alias. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:inset="11%">
            <bitmap
                android:src="@mipmap/ic_wikis_foreground"
                android:tint="#F76831" />
        </inset>
    </foreground>
</adaptive-icon>
