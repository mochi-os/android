<?xml version="1.0" encoding="utf-8"?>
<!-- The Words icon for the Teal theme: the same glyph and inset as
     ic_words, tinted. LauncherTint shows it through its manifest alias. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:inset="10.4%">
            <bitmap
                android:src="@mipmap/ic_words_foreground"
                android:tint="#29B1A4" />
        </inset>
    </foreground>
</adaptive-icon>
