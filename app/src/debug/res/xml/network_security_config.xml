<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain HTTP to this machine only, for the local dev instances reached through
  `adb reverse` (the screenshot emulator). Every other host keeps the platform
  default: HTTPS only, system certificates.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
