<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only, merged over the main manifest: the network security config
  that lets the app reach a Mochi server on this machine over plain HTTP. A
  release build carries no config and so refuses plain HTTP everywhere.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
