            </intent-filter>
            <meta-data android:name="org.mochios.targetApp" android:value="market" />
        </activity>

        <!--
          Staff (operator console) launcher. Hidden by default - only flipped
          to enabled at runtime by StaffAccessController once the bound
          identity passes a `staffApi.me()` check. Disappears again on
          sign-out, role revocation, or any 401/403 from a staff endpoint.
        -->
        <activity
            android:name=".MochiStaffLauncher"
            android:enabled="false"
            android:exported="true"
            android:label="@string/launcher_staff"
            android:icon="@mipmap/ic_staff"
            android:roundIcon="@mipmap/ic_staff_round"
            android:launchMode="singleTop"
            android:taskAffinity="org.mochios.mochi.staff"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mochi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="org.mochios.targetApp" android:value="staff" />
        </activity>

        <activity
            android:name=".MochiCalendarsLauncher"
            android:enabled="true"
            android:exported="true"
            android:label="@string/launcher_calendars"
            android:icon="@mipmap/ic_calendars"
            android:roundIcon="@mipmap/ic_calendars_round"
            android:launchMode="singleTop"
            android:taskAffinity="org.mochios.mochi.calendars"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mochi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="org.mochios.targetApp" android:value="calendars" />
        </activity>

        <!--
          UnifiedPush MessagingReceiver for the Android client. Catches
          MESSAGE / NEW_ENDPOINT / UNREGISTERED / REGISTRATION_FAILED broadcasts
          from PushService and posts a system notification on the right per-app
          channel (routed by the deep-link's first path segment in
          MochiPushDispatcher.channelId). Replaces the four per-app
          XxxPushReceiver classes that existed when feeds / chat / forums /
          projects shipped as separate APKs.
        -->
        <receiver
            android:name=".push.MochiPushDispatcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <!--
                  Mochi's own distributor delivers on this action instead of
                  the connector's MESSAGE, because the local payload is
                  cleartext and the connector would mark it undecrypted and
                  drop it. MochiPushReceiver.onReceive gates it on the
                  sender's PendingIntent creator.
                -->
                <action android:name="org.mochios.android.push.MESSAGE" />
            </intent-filter>
        </receiver>

        <!--
          UnifiedPush distributor receiver. The class lives in lib/android
          and is shared by every Mochi-signed app, but only this shell
          declares it in its manifest so the system distributor picker
          shows a single "Mochi" candidate. Per-app apps (Feeds, Chat,
          Forums, Projects) deliberately do NOT include this receiver.
          See claude/plans/android-notifications.md → "Manifest additions"
          and lib/android/src/distributor/AndroidManifest.xml (template).
        -->
        <receiver
            android:name="org.mochios.android.push.MochiDistributorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="org.mochios.android.push.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          File provider that hands the downloaded update APK to the system
          installer. The APK lives in cacheDir/updates/ and is exposed read-
          only via update_paths.xml; the FLAG_GRANT_READ_URI_PERMISSION on
          the install intent gives the installer transient access without
          needing a runtime permission.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!--
          AccountManager authenticator for cross-app session sharing. Makes
          org.mochios.mochi the owner of the "org.mochios.account" type so
          MochiAccount.upsert() can call addAccountExplicitly without a
          SecurityException. Bound by the system AccountManagerService, so it
          must be exported. The referenced @xml/authenticator declares the
          matching account type (MochiAccount.TYPE).
        -->
        <service
            android:name="org.mochios.android.account.AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!--
          Contacts sync adapter for the Mochi account: the phone's Contacts app
          shows the people app's contacts and edits made there flow back
          (lib/.../sync/ContactsSyncAdapter.kt). Bound by the system sync
          manager, so it must be exported. @xml/contacts is the adapter
          declaration for the contacts authority; @xml/structure tells the
          Contacts app the account holds ordinary, editable contacts.
        -->
        <service
            android:name="org.mochios.android.sync.ContactsSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/contacts" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/structure" />
        </service>

        <!--
          Calendar sync adapter for the Mochi account: the phone's own calendar
          shows the calendars app's events and edits made there flow back
          (lib/.../sync/CalendarsSyncAdapter.kt). Bound by the system sync
          manager, so it must be exported. @xml/calendars is the adapter
          declaration for the calendar authority.
        -->
        <service
            android:name="org.mochios.android.sync.CalendarsSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/calendars" />
        </service>

        <service
            android:name="org.mochios.android.push.PushService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="UnifiedPush message bridge for Mochi" />
        </service>

        <!--
          FCM receiver. Only fires when the Mochi server admin has pasted
          their Firebase config into system settings AND the client has
          successfully registered its installation ID against it. When FCM is
          in use the listening notification (PushService) is not started.
        -->
        <service
            android:name="org.mochios.android.push.MochiFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Register with FCM by Firebase Installation ID instead of the
          deprecated registration token. With this set, getToken() and
          deleteToken() throw; FcmRegistrar uses register() and unregister().
        -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
    </application>
</manifest>
