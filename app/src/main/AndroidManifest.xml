<?xml version="1.0" encoding="utf-8"?>
<!--
  Mochi shell app. Source lives at apps/menu/android/ to match the menu Mochi
  app convention; the Android package is org.mochios.mochi to match the
  user-facing "Mochi" launcher brand.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Contacts sync. The two contacts permissions are dangerous and are
      requested at runtime by the people app's "Sync to this phone" switch,
      never at install; the sync-settings ones are normal and let the switch
      schedule, cancel and observe the adapter.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!--
      Calendar sync. Dangerous in the same way, and requested at runtime by the
      calendars app's "Sync to this phone" switch, never at install.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />

    <!--
      Package visibility, narrowed from QUERY_ALL_PACKAGES: the only thing this
      app needs to see is the set of installed UnifiedPush distributors, which
      MochiPushClient.ensureDistributor enumerates. QUERY_ALL_PACKAGES read the
      whole installed-app list for that, and its other in-tree consumer (the
      distributor election) no longer exists.
    -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <!--
      allowBackup="false": the session cookie, every per-app JWT, the OAuth
      PKCE verifier and the UnifiedPush subscription tokens all sit unencrypted
      in mochi_session / mochi_distributor / mochi_push, so Auto Backup and
      device-to-device transfer would carry a working authenticated session onto
      another device. Nothing else on disk is worth restoring - identity, apps
      and content live on the user's Mochi server and return on next login, so
      local state is only a cache. Preferred over dataExtractionRules +
      fullBackupContent because it cannot drift: a store added later is excluded
      by default rather than backed up until someone remembers to deny it.
    -->
    <application
        android:name=".MochiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mochi">

        <!--
          One activity class per launcher icon (Launchers.kt), each with its own
          task affinity, so every Mochi app runs in a task of its own: a tap on
          its icon resumes that task behind that task's snapshot, or starts a
          fresh one behind the splash, and never shows another app's last frame.
          An <activity-alias> cannot do this - taskAffinity is not an alias
          attribute, an alias inherits its target's - so with aliases every icon
          shared one task, whose snapshot was whichever app was used last.
          singleTop keeps state across taps within a task.
        -->
        <!--
          MainActivity itself has no launcher entry and never draws. It receives
          every `mochi:` URI (mochi:oauth-return, the market checkout return,
          pinned shortcuts, a notification for an app without a launcher entry)
          and forwards the launch to the owning app's class, which handles the
          URI once in its own task. windowNoDisplay and excludeFromRecents keep
          the hand-off invisible; the blank affinity keeps it out of every
          app's task.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Mochi.Trampoline">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                  Single broad filter - claim all `mochi:` URIs. The
                  client routes by slash count in MainActivity.
                  See claude/plans/mochi-uri-scheme.md.
                -->
                <data android:scheme="mochi" />
            </intent-filter>
        </activity>

        <!--
          adjustResize is the other half of MainActivity's enableEdgeToEdge():
          with it the window reports the keyboard as an inset and the content
          pads itself (ComposeBar's windowInsets do exactly that). Left
          unspecified the system falls back to panning the whole window, which
          both scrolls the top bar off-screen and stacks on top of the padding
          the composer already applied - the composer then floats a keyboard's
          height above the keyboard.
        -->
        <!--
          The org.mochios.targetApp meta-data names the Mochi app each class
          hosts; MainActivity reads it from its own component.
        -->
        <activity
            android:name=".MochiFeedsLauncher"
            android:enabled="true"
            android:exported="true"
            android:label="@string/launcher_feeds"
            android:icon="@mipmap/ic_feeds"
            android:roundIcon="@mipmap/ic_feeds_round"
            android:launchMode="singleTop"
            android:taskAffinity="org.mochios.mochi.feeds"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mochi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="org.mochios.targetApp" android:value="feeds" />
        </activity>

        <activity
            android:name=".MochiChatLauncher"
            android:enabled="true"
            android:exported="true"
            android:label="@string/launcher_chat"
            android:icon="@mipmap/ic_chat"
            android:roundIcon="@mipmap/ic_chat_round"
            android:launchMode="singleTop"
            android:taskAffinity="org.mochios.mochi.chat"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mochi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="org.mochios.targetApp" android:value="chat" />
        </activity>

        <activity
